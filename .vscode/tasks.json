{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-DTENSORRT_ROOT=/home/gw/TensorRT-8.6.1.6",
                "-DCMAKE_CUDA_ARCHITECTURES=86",
                "-DTRT_LEARNING_PROJECT=tensorrt-8.6/01-mnist-wts"
            ],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "-j"
            ],
            "dependsOn": "CMake Configure",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc", "$nvcc"]
        }
    ]
}
